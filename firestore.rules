rules_version = '2';

// Anyone with a link can read a board. Each browser signs in anonymously; a person doc
// is edited only by the uid that owns it. Taking over a name (another device, or after
// "Not you?") needs a claim doc whose proof matches the unreadable password hash.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function slotsOk(d) {
      return d.slots is list && d.slots.size() <= 2000 && (d.vote == null || (d.vote is string && d.vote.size() <= 40));
    }

    match /events/{eventId} {
      function at(col, key) {
        return /databases/$(database)/documents/events/$(eventId)/$(col)/$(key);
      }

      allow get: if true;
      allow list: if false;
      allow update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'start', 'end', 'timeZone', 'duration', 'kind', 'dates', 'days', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 64
        && request.resource.data.kind in ['dates', 'dow']
        && (request.resource.data.kind == 'dates'
          ? request.resource.data.dates is list && request.resource.data.dates.size() > 0 && request.resource.data.dates.size() <= 35
          : request.resource.data.days is list && request.resource.data.days.size() > 0 && request.resource.data.days.size() <= 7)
        && request.resource.data.start is int && request.resource.data.end is int
        && request.resource.data.start >= 0 && request.resource.data.end <= 1440
        && request.resource.data.start < request.resource.data.end
        && request.resource.data.duration is int && request.resource.data.duration > 0
        && request.resource.data.duration <= request.resource.data.end - request.resource.data.start;

      match /people/{key} {
        allow read: if true;
        allow delete: if false;
        allow create: if signedIn()
          && existsAfter(/databases/$(database)/documents/events/$(eventId))
          && request.resource.data.keys().hasOnly(['name', 'slots', 'optional', 'vote', 'hasPassword', 'uid'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && request.resource.data.optional is bool
          && request.resource.data.hasPassword is bool
          && request.resource.data.hasPassword == existsAfter(at('secrets', key))
          && slotsOk(request.resource.data);
        allow update: if signedIn() && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'vote'])
            && slotsOk(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
            && request.resource.data.uid == request.auth.uid
            && getAfter(at('claims', request.auth.uid)).data.key == key)
        );
      }

      match /secrets/{key} {
        allow read, update, delete: if false;
        allow create: if signedIn()
          && !exists(at('people', key))
          && getAfter(at('people', key)).data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['hash'])
          && request.resource.data.hash is string && request.resource.data.hash.size() == 64;
      }

      match /claims/{uid} {
        allow read, delete: if false;
        allow create, update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['key', 'proof'])
          && request.resource.data.key is string
          && exists(at('people', request.resource.data.key))
          && (!exists(at('secrets', request.resource.data.key))
            || get(at('secrets', request.resource.data.key)).data.hash == request.resource.data.proof);
      }
    }
  }
}
